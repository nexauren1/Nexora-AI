<resources>
    <style
        name="AppTheme"
        parent="android:style/Theme.Material.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/nexora_primary</item>
        <item name="android:windowBackground">@color/nexora_background</item>
        <item name="android:navigationBarColor">@color/nexora_background</item>
        <item name="android:statusBarColor">@color/nexora_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="NexoraToolButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/nexora_muted</item>
        <item name="android:background">@drawable/bg_tool</item>
    </style>

    <style name="NexoraIconButton" parent="android:style/Widget.Material.ImageButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">@color/nexora_muted</item>
        <item name="android:background">@drawable/bg_soft</item>
    </style>

    <style name="NexoraSendButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_primary</item>
    </style>
</resources>