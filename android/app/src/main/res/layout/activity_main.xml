<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nexora_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/white">

        <TextView
            android:id="@+id/appMark"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="N"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nexora AI"
                android:textColor="@color/nexora_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IA pronta"
                android:textColor="@color/nexora_success"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/credits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:text="100 créditos"
            android:textColor="@color/nexora_muted"
            android:textSize="11sp"
            android:background="@drawable/bg_soft" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/toolScroll"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:scrollbars="none"
        android:background="@color/nexora_background">

        <LinearLayout
            android:id="@+id/tools"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <Button
                android:id="@+id/toolChat"
                style="@style/NexoraToolButton"
                android:text="Chat" />

            <Button
                android:id="@+id/toolWork"
                style="@style/NexoraToolButton"
                android:text="Trabalhos" />

            <Button
                android:id="@+id/toolSummary"
                style="@style/NexoraToolButton"
                android:text="Resumos" />

            <Button
                android:id="@+id/toolPdf"
                style="@style/NexoraToolButton"
                android:text="PDF" />

            <Button
                android:id="@+id/toolImage"
                style="@style/NexoraToolButton"
                android:text="Imagem" />

            <Button
                android:id="@+id/toolAudio"
                style="@style/NexoraToolButton"
                android:text="Áudio" />

            <Button
                android:id="@+id/toolVideo"
                style="@style/NexoraToolButton"
                android:text="Vídeo" />

            <Button
                android:id="@+id/toolCode"
                style="@style/NexoraToolButton"
                android:text="Código" />

            <Button
                android:id="@+id/toolGenerate"
                style="@style/NexoraToolButton"
                android:text="Gerar imagem" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/messageScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@color/nexora_background">

        <LinearLayout
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="N"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Como posso ajudar?"
                    android:textColor="@color/nexora_text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Conversa, trabalhos, resumos, PDF, imagens, áudio, vídeo e código."
                    android:textColor="@color/nexora_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/fileLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="5dp"
        android:paddingBottom="3dp"
        android:textColor="@color/nexora_muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="9dp"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/addButton"
            style="@style/NexoraIconButton"
            android:contentDescription="Adicionar ficheiro"
            android:src="@android:drawable/ic_menu_add" />

        <ImageButton
            android:id="@+id/cameraButton"
            style="@style/NexoraIconButton"
            android:contentDescription="Câmara"
            android:src="@android:drawable/ic_menu_camera" />

        <EditText
            android:id="@+id/prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Mensagem para Nexora AI"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:minHeight="46dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/nexora_text"
            android:textColorHint="@color/nexora_muted"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/micButton"
            style="@style/NexoraIconButton"
            android:contentDescription="Ditado"
            android:src="@android:drawable/ic_btn_speak_now" />

        <Button
            android:id="@+id/sendButton"
            style="@style/NexoraSendButton"
            android:text="↑"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/modeLabel"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center"
        android:text="Modo: Chat"
        android:textColor="@color/nexora_muted"
        android:textSize="10sp"
        android:background="@color/nexora_background" />
</LinearLayout>
