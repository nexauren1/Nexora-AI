<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nexora_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/menuButton"
            style="@style/NexoraIconButton"
            android:contentDescription="Menu"
            android:src="@android:drawable/ic_menu_more" />

        <TextView
            android:id="@+id/appMark"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:text="N"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/bg_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="9dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nexora AI"
                android:textColor="@color/nexora_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A preparar"
                android:textColor="@color/nexora_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/credits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:text="100 créditos"
            android:textColor="@color/nexora_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_nav_selected" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O teu espaço de IA"
                    android:textColor="@color/nexora_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Conversa, cria, analisa e resolve tudo num só lugar."
                    android:textColor="@color/nexora_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/toolScroll"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:scrollbars="none"
                android:paddingStart="7dp"
                android:paddingEnd="7dp">

                <LinearLayout
                    android:id="@+id/tools"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/toolChat"
                        style="@style/NexoraToolButton"
                        android:text="Chat" />

                    <Button
                        android:id="@+id/toolWork"
                        style="@style/NexoraToolButton"
                        android:text="Trabalhos" />

                    <Button
                        android:id="@+id/toolSummary"
                        style="@style/NexoraToolButton"
                        android:text="Resumos" />

                    <Button
                        android:id="@+id/toolPdf"
                        style="@style/NexoraToolButton"
                        android:text="PDF" />

                    <Button
                        android:id="@+id/toolImage"
                        style="@style/NexoraToolButton"
                        android:text="Imagem" />

                    <Button
                        android:id="@+id/toolAudio"
                        style="@style/NexoraToolButton"
                        android:text="Áudio" />

                    <Button
                        android:id="@+id/toolVideo"
                        style="@style/NexoraToolButton"
                        android:text="Vídeo" />

                    <Button
                        android:id="@+id/toolCode"
                        style="@style/NexoraToolButton"
                        android:text="Código" />

                    <Button
                        android:id="@+id/toolGenerate"
                        style="@style/NexoraToolButton"
                        android:text="Criar imagem" />
                </LinearLayout>
            </HorizontalScrollView>

            <ScrollView
                android:id="@+id/messageScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:background="@color/nexora_background">

                <LinearLayout
                    android:id="@+id/messages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:id="@+id/welcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="28dp"
                        android:paddingBottom="22dp">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="N"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:text="Como posso ajudar?"
                            android:textColor="@color/nexora_text"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:text="Escolhe uma ferramenta ou escreve uma mensagem para começar."
                            android:textColor="@color/nexora_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <TextView
                android:id="@+id/fileLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="4dp"
                android:paddingBottom="3dp"
                android:textColor="@color/nexora_muted"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/composer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="9dp"
                android:paddingTop="8dp"
                android:paddingEnd="9dp"
                android:paddingBottom="8dp"
                android:background="@color/white">

                <ImageButton
                    android:id="@+id/addButton"
                    style="@style/NexoraIconButton"
                    android:contentDescription="Adicionar ficheiro"
                    android:src="@android:drawable/ic_menu_add" />

                <ImageButton
                    android:id="@+id/cameraButton"
                    style="@style/NexoraIconButton"
                    android:contentDescription="Câmara"
                    android:src="@android:drawable/ic_menu_camera" />

                <EditText
                    android:id="@+id/prompt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="Mensagem para Nexora AI"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:minHeight="46dp"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/nexora_text"
                    android:textColorHint="@color/nexora_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/micButton"
                    style="@style/NexoraIconButton"
                    android:contentDescription="Ditado"
                    android:src="@android:drawable/ic_btn_speak_now" />

                <Button
                    android:id="@+id/sendButton"
                    style="@style/NexoraSendButton"
                    android:text="↑"
                    android:textColor="@color/white"
                    android:textSize="18sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/modeLabel"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="Modo: Chat"
                android:textColor="@color/nexora_muted"
                android:textSize="9sp"
                android:background="@color/nexora_background" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/historyPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Histórico"
                android:textColor="@color/nexora_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mensagens desta sessão ficam organizadas aqui."
                android:textColor="@color/nexora_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/clearHistoryButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="Limpar sessão"
                android:textAllCaps="false"
                android:textColor="@color/nexora_danger"
                android:background="@drawable/bg_soft" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <ScrollView
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Definições"
                    android:textColor="@color/nexora_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Controla a experiência do Nexora AI."
                    android:textColor="@color/nexora_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:padding="15dp"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conta e créditos"
                        android:textColor="@color/nexora_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settingsCredits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Créditos disponíveis: 100"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Plano atual: Free · assinaturas serão adicionadas depois."
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="15dp"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ligação"
                        android:textColor="@color/nexora_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settingsConnection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="A verificar ligação..."
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/aboutButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Sobre o Nexora AI"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="15dp"
                    android:textColor="@color/nexora_text"
                    android:background="@drawable/bg_card" />

                <Button
                    android:id="@+id/privacyButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Privacidade"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="15dp"
                    android:textColor="@color/nexora_text"
                    android:background="@drawable/bg_card" />

                <Button
                    android:id="@+id/clearSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Limpar conversa atual"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="15dp"
                    android:textColor="@color/nexora_danger"
                    android:background="@drawable/bg_card" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="Nexora AI · versão 0.3"
                    android:textColor="@color/nexora_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/white">

        <Button
            android:id="@+id/navHome"
            style="@style/NexoraNavButton"
            android:text="Início" />

        <Button
            android:id="@+id/navHistory"
            style="@style/NexoraNavButton"
            android:text="Histórico" />

        <Button
            android:id="@+id/navSettings"
            style="@style/NexoraNavButton"
            android:text="Definições" />
    </LinearLayout>
</LinearLayout>
